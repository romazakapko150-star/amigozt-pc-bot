# ---- Telegram ----
# Get the token from @BotFather. NEVER commit the real value.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# ---- Database ----
# Dev (default, no external services required):
DATABASE_URL=sqlite+aiosqlite:///./amigozt.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/amigozt

# ---- AI visualisation (optional) ----
# With a key set, build cards become photorealistic renders of the chosen
# parts via the OpenAI Images API (paid per render, cached per build+look).
# Without it the bot draws its own schematic card. Never commit the key.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
AI_VISUALIZATION_ENABLED=true
# Discard updates queued while the bot was offline (default true). Set to
# false right after planned downtime so the /start messages customers sent
# meanwhile still get an answer.
DROP_PENDING_UPDATES=true
# Output size and quality (the main cost lever): low / medium / high.
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_QUALITY=medium
AI_IMAGE_TIMEOUT_SECONDS=90
# Paid attempts per build fingerprint before the visualiser gives up.
AI_IMAGE_MAX_ATTEMPTS=2
# Feed verified product photos (catalogue image_url) to the model as visual
# references. Only enable for images you are licensed to reuse.
AI_REFERENCE_IMAGES_ENABLED=false
# Approximate price of one image call, used only for the admin spend counter.
AI_IMAGE_COST_USD=0.042
# Render a product's visual the first time a customer opens its card (off:
# product visuals are produced by scripts/generate_visual_library.py).
VISUAL_ON_DEMAND_COMPONENTS=false

# ---- Admin ----
# Comma-separated numeric Telegram user IDs allowed to use /admin and /leads.
# Find yours by messaging @userinfobot. Usernames do NOT work here.
# Leave empty to disable the admin interface entirely.
ADMIN_TELEGRAM_IDS=123456789,987654321

# ---- Branding ----
# The official AmigoZT PC image shown on /start, the configurator start and the
# order confirmation. Path relative to the project root (or absolute). Replace
# the file - or point this at another one - to rebrand without code changes.
BRAND_IMAGE=app/assets/brand/amigozt_pc.png
# Optional: Telegram file_id of the already-uploaded image. The bot learns and
# caches the id itself after the first upload (media/brand_file_ids.json).
BRAND_IMAGE_FILE_ID=
# Optional per-purpose assets; each falls back to BRAND_IMAGE when empty.
BRAND_AVATAR=
BRAND_HEADER=
BRAND_BUILD_DEFAULT=
BRAND_ORDER_CONFIRMATION=
# The same asset is not re-sent to the same chat within this many minutes.
BRAND_RESEND_COOLDOWN_MINUTES=30

# ---- Business ----
# All of this is internal and is never shown to a customer.
# What an hour of your time should earn. The price is built from estimated
# hours x this rate, not from a flat assembly fee.
TARGET_HOURLY_EARNINGS_PLN=150
# Profit floors. Whichever binds harder wins.
MINIMUM_PROFIT_PER_ORDER_PLN=500
MINIMUM_PROFIT_PER_HOUR_PLN=100
# Prices are rounded up to end in (step - 1): 6 562 -> 6 599.
PRICE_ROUNDING_STEP_PLN=100

# ---- Runtime ----
ENVIRONMENT=dev
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ru
# Max updates per user per second before throttling kicks in
RATE_LIMIT_PER_SECOND=1.5
